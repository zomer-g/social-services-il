{
  "description": "The shape one agreement produces. Every key is required; a value the document does not carry is null rather than absent, because a strict schema cannot express 'sometimes there'. Nulls are dropped before anything is pushed. The objects under `services` are, once nulls are dropped, exactly the payload POST /api/v1/ingest/match and POST /api/v1/ingest/services take.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "document",
    "verdict",
    "services",
    "unmapped",
    "questions"
  ],
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "external_id",
        "title",
        "kind",
        "authority",
        "provider",
        "provider_registration_number",
        "signed_on",
        "starts_on",
        "ends_on",
        "annual_value_ils",
        "reference_numbers"
      ],
      "properties": {
        "external_id": {
          "type": "string",
          "description": "A stable id for this document: the agreement or tender number where it has one, otherwise the file name without its extension. Re-running the pipeline must produce the same value."
        },
        "title": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "agreement",
            "tender",
            "framework_agreement",
            "support_grant",
            "amendment",
            "other"
          ]
        },
        "authority": {
          "description": "The body paying: a ministry, a municipality, a statutory corporation.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider": {
          "description": "The body that will deliver the service to the public. This is the organization on the service record, not the authority.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider_registration_number": {
          "description": "מספר עמותה / ח.פ. — 9 digits. This is what lets the same provider from two sources meet, so copy it exactly and never guess it.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "signed_on": {
          "description": "ISO date, YYYY-MM-DD.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "starts_on": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "ends_on": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "annual_value_ils": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "reference_numbers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Tender numbers, decision numbers, contract numbers appearing in the document."
        }
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "confidence",
        "reason",
        "subject",
        "expired",
        "beneficiary"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "relevant",
            "partial",
            "irrelevant"
          ],
          "description": "relevant: the document describes at least one service a member of the public can receive, and every such service was extracted. partial: it describes one, but the document does not say enough to build a usable record. irrelevant: nothing in it is a service to the public."
        },
        "confidence": {
          "type": "number",
          "description": "Between 0 and 1."
        },
        "reason": {
          "type": "string",
          "description": "One or two sentences in Hebrew, naming what in the document decided it."
        },
        "subject": {
          "type": "string",
          "enum": [
            "service_to_public",
            "goods",
            "works_or_construction",
            "professional_services_to_the_authority",
            "staffing",
            "property_or_finance",
            "internal_operations",
            "unclear"
          ]
        },
        "expired": {
          "type": "boolean",
          "description": "True when the agreement's end date has passed. Judged against the date given in the request, never against your own idea of today."
        },
        "beneficiary": {
          "description": "Who receives what is bought, in the document's own words. A person in distress, or the authority itself — this is the question the verdict turns on.",
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "services": {
      "type": "array",
      "description": "One entry per distinct offering, not per document. A framework agreement covering a day centre and a meals-on-wheels round is two services; the same day centre in four towns is one service with four branches.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "external_id",
          "name",
          "alternate_names",
          "description",
          "details",
          "payment_required",
          "payment_details",
          "phone_numbers",
          "email_address",
          "urls",
          "implements",
          "source_updated_at",
          "responses",
          "situations",
          "national_service",
          "organization",
          "branches",
          "confidence",
          "source_quotes"
        ],
        "properties": {
          "external_id": {
            "type": "string",
            "description": "Stable and derived from the document id, e.g. \"12-2024-day-centre\". Re-running must produce the same value, because it is what makes a second push update rather than duplicate."
          },
          "name": {
            "type": "string",
            "description": "What a person would call it, in Hebrew. Not the contract's title: \"מרכז יום לקשיש\", not \"הסכם למתן שירותי מרכז יום\"."
          },
          "alternate_names": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The programme name, the provider's own name for it, the ministry's name for it. Used to find the service if it is already in the corpus."
          },
          "description": {
            "description": "Two or three sentences: what a person gets. Written for the person, not for the auditor.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "details": {
            "description": "Eligibility, opening hours, how to apply, what to bring — as the document states them.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "payment_required": {
            "description": "true when the recipient pays anything, false only when the document says it is free to them, null when it does not say. Payment by the authority to the provider is not payment by the recipient.",
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "payment_details": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "phone_numbers": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Numbers a member of the public can call to reach the service. Never the contract manager's line."
          },
          "email_address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "urls": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "href",
                "title"
              ],
              "properties": {
                "href": {
                  "type": "string"
                },
                "title": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "implements": {
            "description": "The programme or agreement this delivers, in words: \"הסכם התקשרות 12/2024 עם עיריית חיפה\".",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_updated_at": {
            "description": "ISO 8601 with an offset. The date the agreement was signed or last amended — how old this record is.",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "responses": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Response taxonomy ids from the list supplied in this prompt. At least one, exactly as written there. A service with none cannot be found by anybody. At least 1."
          },
          "situations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "national_service": {
            "type": "boolean",
            "description": "True only for a service delivered anywhere in the country with no place to go to. A municipal contract is not nationwide."
          },
          "organization": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "external_id",
              "name",
              "short_name",
              "kind",
              "purpose",
              "phone_numbers",
              "email_address",
              "urls"
            ],
            "properties": {
              "id": {
                "description": "The provider's registration number, digits only, when the document states it. Nothing else goes here.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "external_id": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "name": {
                "type": "string",
                "description": "The provider. Not the authority."
              },
              "short_name": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "kind": {
                "description": "One of: עמותה, חברה לתועלת הציבור, משרד ממשלתי, רשות מקומית, תאגיד סטטוטורי, חברה עסקית, מוסד ציבורי. Null when the document does not say.",
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "purpose": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "phone_numbers": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "email_address": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "urls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "href",
                    "title"
                  ],
                  "properties": {
                    "href": {
                      "type": "string"
                    },
                    "title": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "branches": {
            "type": "array",
            "description": "Every place the service is actually delivered. Empty for a nationwide service. A branch with neither an address nor a city cannot be shown on the site, so say which town at the very least.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "external_id",
                "name",
                "operating_unit",
                "address",
                "city",
                "phone_numbers",
                "email_address",
                "national_service"
              ],
              "properties": {
                "external_id": {
                  "type": "string"
                },
                "name": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "operating_unit": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "address": {
                  "description": "Street and number as written. Do not invent one.",
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "city": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "phone_numbers": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "email_address": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "national_service": {
                  "type": "boolean"
                }
              }
            }
          },
          "confidence": {
            "type": "number",
            "description": "Between 0 and 1."
          },
          "source_quotes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Short quotations from the document that this record rests on, so a reviewer can check it without reading the whole agreement. At least one."
          }
        }
      }
    },
    "unmapped": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Things in the document that look like services to the public but could not be turned into a record, and what was missing."
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "What a person would have to check before this is published. Empty when there is nothing."
    }
  }
}
